{
  "name": "@xlscalc/formula-engine",
  "version": "0.3.0",
  "description": "Zero-dependency Excel formula parser and evaluator. Fail-loud: never renders a guessed number.",
  "keywords": ["excel", "xlsx", "formula", "spreadsheet", "parser", "evaluator", "calculation"],
  "license": "MIT",
  "author": "Victor-EU",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Victor-EU/xls-renderer-calc.git",
    "directory": "packages/formula-engine"
  },
  "bugs": "https://github.com/Victor-EU/xls-renderer-calc/issues",
  "homepage": "https://github.com/Victor-EU/xls-renderer-calc/tree/main/packages/formula-engine#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "!src/**/*.test.ts", "CAPABILITY.md", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('../../CAPABILITY.md','CAPABILITY.md')\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
