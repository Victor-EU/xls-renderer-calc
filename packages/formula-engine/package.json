{
  "name": "@xlscalc/formula-engine",
  "version": "0.2.0",
  "description": "Zero-dependency Excel formula parser and evaluator. Fail-loud: never renders a guessed number.",
  "keywords": ["excel", "xlsx", "formula", "spreadsheet", "parser", "evaluator", "calculation"],
  "license": "MIT",
  "author": "Victor-EU",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  }
}
