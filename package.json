{
  "name": "xls-renderer-calc",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Victor-EU/xls-renderer-calc.git"
  },
  "bugs": "https://github.com/Victor-EU/xls-renderer-calc/issues",
  "homepage": "https://github.com/Victor-EU/xls-renderer-calc#readme",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @xlscalc/formula-engine && npm run build -w @xlscalc/xlsx-preview",
    "clean": "npm run clean --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/formula-engine packages/xlsx-preview --pretty false && tsc -p apps/demo/tsconfig.json --pretty false",
    "smoke": "node tools/verify/package-smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "dev": "npm run dev -w @xlscalc/demo",
    "oracle": "vitest run tools/oracle/",
    "oracle:gen": "python3 tools/oracle/generate.py",
    "eval": "vitest run eval/",
    "eval:gen": "python3 eval/build.py",
    "eval:real": "vitest run eval/real/",
    "eval:real:gen": "python3 eval/real/inventory.py && python3 eval/real/recalc.py"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.62.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
